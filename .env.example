
# Database
DOCREAPER_DATABASE_URL=sqlite:///./docreaper.db

# Existing cloud storage
DOCREAPER_GCS_BUCKET=
DOCREAPER_GCS_PREFIX=books

# Pipeline
DOCREAPER_TARGET_UNIQUE_BOOKS=270
DOCREAPER_MAX_DOWNLOAD_MB=100
DOCREAPER_DOWNLOAD_DELAY_SECONDS=1.0
DOCREAPER_DOWNLOAD_RETRIES=3
DOCREAPER_REQUEST_TIMEOUT=60
DOCREAPER_USER_AGENT=DocReaper/1.0

# Fingerprinting
DOCREAPER_NEAR_DUPLICATE_THRESHOLD=0.85
DOCREAPER_MIN_TEXT_CHARS=1000

# Dashboard security
DOCREAPER_CONTROL_TOKEN=

# Google Drive OAuth
DOCREAPER_GOOGLE_CLIENT_ID=
DOCREAPER_GOOGLE_CLIENT_SECRET=
DOCREAPER_GOOGLE_REDIRECT_URI=https://docreaper.onrender.com/auth/google/callback
DOCREAPER_GOOGLE_OAUTH_STATE_SECRET=
DOCREAPER_GOOGLE_DRIVE_REFRESH_TOKEN=
DOCREAPER_GOOGLE_DRIVE_FOLDER_ID=
