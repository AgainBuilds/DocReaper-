
name: DocReaper Collector

on:
  workflow_dispatch:

  schedule:
    - cron: "17 2,8,14,20 * * *"

permissions:
  contents: read

concurrency:
  group: docreaper-collector
  cancel-in-progress: false

jobs:
  collect:
    name: Run DocReaper Engine
    runs-on: ubuntu-latest
    timeout-minutes: 55

    env:
      DOCREAPER_DATABASE_URL: ${{ secrets.DOCREAPER_DATABASE_URL }}
      DOCREAPER_GOOGLE_CLIENT_ID: ${{ secrets.DOCREAPER_GOOGLE_CLIENT_ID }}
      DOCREAPER_GOOGLE_CLIENT_SECRET: ${{ secrets.DOCREAPER_GOOGLE_CLIENT_SECRET }}
      DOCREAPER_GOOGLE_DRIVE_REFRESH_TOKEN: ${{ secrets.DOCREAPER_GOOGLE_DRIVE_REFRESH_TOKEN }}
      DOCREAPER_GOOGLE_DRIVE_FOLDER_ID: ${{ secrets.DOCREAPER_GOOGLE_DRIVE_FOLDER_ID }}
      DOCREAPER_TARGET_UNIQUE_BOOKS: "270"
      PYTHONUNBUFFERED: "1"

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install DocReaper
        run: |
          python -m pip install --upgrade pip
          pip install -e .

      - name: Validate configuration
        run: |
          python - <<'PY'
          import os
          required = [
              "DOCREAPER_DATABASE_URL",
              "DOCREAPER_GOOGLE_CLIENT_ID",
              "DOCREAPER_GOOGLE_DRIVE_REFRESH_TOKEN",
          ]
          missing = [key for key in required if not os.getenv(key)]
          if missing:
              raise SystemExit(
                  "Missing GitHub Actions secrets: " + ", ".join(missing)
              )
          print("Required configuration variables are present.")
          PY

      - name: Run collector
        run: python worker.py
